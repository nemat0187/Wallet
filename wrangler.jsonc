{
  // Cloudflare Worker that serves both the API (/api/*) and the web app (static files in ./dist).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wallet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "tsconfig": "./tsconfig.worker.json",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wallet-db",
      // Filled in automatically by scripts/deploy.mjs. Any value works for local development.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Background jobs: AI categorization backlog, budget alerts, daily FX rates, weekly/monthly AI reports.
  "triggers": { "crons": ["7 * * * *"] },
  "observability": { "enabled": true }
}
